	partition Fact_sales = m
		mode: import
		source =
				let
				    원본 = Excel.Workbook(File.Contents("C:\Users\sunne\OneDrive - Zalesia Inc\바탕 화면\교육대비\본사교육\[잘레시아] 교육용 데이터.xlsx"), null, true),
				    Fact_sales_Sheet = 원본{[Item="Fact_sales",Kind="Sheet"]}[Data],
				    #"승격된 헤더" = Table.PromoteHeaders(Fact_sales_Sheet, [PromoteAllScalars=true]),
				    #"변경된 유형" = Table.TransformColumnTypes(#"승격된 헤더",{{"ProductKey", Int64.Type}, {"OrderDateKey", Int64.Type}, {"StoreKey", Int64.Type}, {"CustomerKey", Int64.Type}, {"ResellerKey", Int64.Type}, {"UnitPrice", type number}, {"ExtendedAmount", type number}, {"ProductStandardCost", type number}, {"TotalProductCost", type number}, {"SalesAmount", type number}, {"TaxAmt", type number}}),
				    반올림 = Table.TransformColumns(#"변경된 유형",{{"UnitPrice", each Number.Round(_, 0), type number}, {"ExtendedAmount", each Number.Round(_, 0), type number}, {"ProductStandardCost", each Number.Round(_, 0), type number}, {"TotalProductCost", each Number.Round(_, 0), type number}, {"SalesAmount", each Number.Round(_, 0), type number}, {"TaxAmt", each Number.Round(_, 0), type number}}),
				    #"추가된 사용자 지정 항목" = Table.AddColumn(반올림, "상중하", each if [SalesAmount] <= 1000 then "C" else if [SalesAmount] <= 3500 then "B" else if [SalesAmount] > 3500 then "A" else [SalesAmount]),
				    #"병합된 쿼리" = Table.NestedJoin(#"추가된 사용자 지정 항목", {"CustomerKey"}, Dim_customer, {"CustomerKey"}, "Dim_customer", JoinKind.LeftOuter),
				    #"확장된 Dim_customer" = Table.ExpandTableColumn(#"병합된 쿼리", "Dim_customer", {"Gender"}, {"Gender"})
				in
				    #"확장된 Dim_customer"

	annotation PBI_ResultType = Table

