table Fact_sales
	lineageTag: dc1203bf-7568-4a3e-81cd-c592bbb3ecb7

	measure 매출액 = SUM('Fact_sales'[SalesAmount])
		formatString: #,0
		lineageTag: 0b050deb-de1d-4131-92a0-2950742c901e

	measure 전월매출액 = CALCULATE([매출액], DATEADD('Dim_Date'[Date], -1, MONTH))
		formatString: #,0
		lineageTag: 35374ec6-0f18-4d87-b228-8066c4471bce

	measure 매출액차이 = [매출액]-[전월매출액]
		formatString: #,0
		lineageTag: 4718af6a-6aaf-4bd4-8b5a-d06b8f7c4f60

	measure 동적타이틀 =
			IF(ISBLANK(SELECTEDVALUE('Dim_product'[ProductCategory]))
			                ,"Sales Detail"
			                , "'" & SELECTEDVALUE('Dim_product'[ProductCategory]) & "' - Sales Detail")
		lineageTag: bb225561-9cc6-48ac-bd6f-0a971701a7e8

