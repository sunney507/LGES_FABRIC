				    #"승격된 헤더" = Table.PromoteHeaders(Dim_product_Sheet, [PromoteAllScalars=true]),
				    #"변경된 유형" = Table.TransformColumnTypes(#"승격된 헤더",{{"ProductKey", Int64.Type}, {"ProductAlternateKey", type text}, {"ProductSubcategory", type text}, {"ProductCategory", type text}, {"ProductName", type text}, {"StandardCost", type text}, {"Color", type text}, {"Weight", type any}, {"ModelName", type text}, {"EnglishDescription", type text}, {"Status", type text}}),
				    #"삽입된 처음 문자" = Table.AddColumn(#"변경된 유형", "처음 문자", each Text.Start([Color], 1), type text),
				    #"삽입된 병합된 열" = Table.AddColumn(#"삽입된 처음 문자", "추출열", each Text.Combine({[ProductCategory], [ProductSubcategory]}, "-"), type text)
				in
