        "dataCategory": "Time",
        "lineageTag": "af8326ed-17ca-477f-9c10-4f9af545f385",
        "partitions": [
          {
            "name": "DimDate",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    MinDate = Date.FromText(List.Min(FactSales[DateKey])),",
                "    MaxDate = Date.FromText(List.Max(FactSales[DateKey])),",
                "    MinDate_LastYear = Date.StartOfYear(Date.AddYears(MinDate, -1)),",
                "",
                "    NumOfDays = Duration.Days(MaxDate - MinDate_LastYear) + 1,",
                "    AllDates = List.Dates(MinDate_LastYear, NumOfDays, #duration(1, 0, 0, 0)),",
                "    #\"테이블로 변환됨\" = Table.FromList(AllDates, Splitter.SplitByNothing(), null, null, ExtraValues.Error),",
                "    #\"이름을 바꾼 열 수\" = Table.RenameColumns(#\"테이블로 변환됨\",{{\"Column1\", \"Date\"}}),",
                "    #\"삽입된 연도\" = Table.AddColumn(#\"이름을 바꾼 열 수\", \"년\", each Date.Year([Date]), Int64.Type),",
                "    #\"삽입된 월\" = Table.AddColumn(#\"삽입된 연도\", \"월\", each Date.Month([Date]), Int64.Type),",
                "    #\"삽입된 처음 문자\" = Table.AddColumn(#\"삽입된 월\", \"처음 문자\", each Text.Start(Text.From([Date], \"ko-KR\"), 7), type text),",
                "    #\"이름을 바꾼 열 수1\" = Table.RenameColumns(#\"삽입된 처음 문자\",{{\"처음 문자\", \"Base_Date\"}}),",
                "    #\"추가된 사용자 지정 항목\" = Table.AddColumn(#\"이름을 바꾼 열 수1\", \"DateKey\", each Date.ToText([Date], \"YYYYMMDD\")),",
                "    #\"변경된 유형\" = Table.TransformColumnTypes(#\"추가된 사용자 지정 항목\",{{\"Date\", type date}})",
                "in",
                "    #\"변경된 유형\""
              ],
              "type": "m"
            }
          }
        ]
      },
