            ],
            "dataType": "string",
            "lineageTag": "c408c246-33d5-49cc-bab3-6999db9893a7",
            "sourceColumn": "KOR_DESC",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "ff979596-6b22-4bd1-8af3-491dc30ec621",
        "measures": [
          {
            "name": "전년당년",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "",
              "var SelectYear = MAX('DimDate'[년])",
              "var LastYear = CALCULATE(MAX('DimDate'[년]), DATEADD('DimDate'[Date], -1, YEAR))",
              "var SelectHeader1 = MAX('DimDate (2)'[년])",
              "var SelectHeader2 = MAX('DimDate (2)'[Header2])",
              "",
              "var SelectYearSales = SUM('FactSales'[Total_Sales])",
              "var SelectYearLastSales = CALCULATE(SUM('FactSales'[Total_Sales]), ",
              "                            DATEADD(DimDate[Date], -1, MONTH))",
              "var LastYearSales = CALCULATE(SUM('FactSales'[Total_Sales]), ",
              "                            DATEADD('DimDate'[Date], -1, YEAR))",
              "var LastYearLastSales = CALCULATE(SUM('FactSales'[Total_Sales]), ",
              "                            DATEADD(DimDate[Date], -1, MONTH))",
              "",
              "var SelectYearP = FORMAT(DIVIDE(SelectYearSales, SelectYearLastSales), \"#,##%\")",
              "var LastYearP = FORMAT(DIVIDE(LastYearSales, LastYearLastSales), \"#,##%\")",
              "",
              "RETURN SWITCH(TRUE(),",
              "        AND(SelectHeader1 = LastYear, SelectHeader2 = \"매출액\"), LastYearSales",
              "        , AND(SelectHeader1 = LastYear, SelectHeader2 = \"%\"), LastYearP",
              "        , AND(SelectHeader1 = SelectYear, SelectHeader2 = \"매출액\"), SelectYearSales",
              "        , AND(SelectHeader1 = SelectYear, SelectHeader2 = \"%\"), SelectYearP",
              "        )  ",
              ""
            ],
            "lineageTag": "f10b76c6-9ecd-4c67-aee9-a140457c8ca9"
          },
          {
            "name": "측정값",
            "expression": "1",
            "formatString": "0%;-0%;0%",
            "lineageTag": "d0216e25-0a3e-46a2-9099-744ef0172556"
          },
          {
            "name": "측정값 2",
            "expression": "USERNAME()",
            "lineageTag": "f10cdef2-853b-4ce8-98e8-399dd9612927"
          }
        ],
